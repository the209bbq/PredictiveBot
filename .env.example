# Optional. Public Polymarket US market data does not require keys.
# Generate keys later at https://polymarket.us/developer after KYC.
# Never commit real values. Copy this file to .env locally.

POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=

# Must stay false in this version. Setting this to true makes the bot raise
# instead of placing any live order.
POLYMARKET_LIVE_TRADING=false
