# Optional local convenience only. Env vars are the primary way to pass secrets.
# Copy to .env if you want python-dotenv to load them — never commit .env.
# Public Kalshi and Polymarket US market data do not require keys.

# Polymarket US (unused unless you later implement live trading — still disabled)
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=
POLYMARKET_LIVE_TRADING=false

# Kalshi DEMO only. Production trading is refused even if you set a prod URL.
# Create keys at https://demo.kalshi.co/ account settings → API Keys.
# Demo keys are often Ed25519 PKCS#8 (-----BEGIN PRIVATE KEY-----), not RSA.
# Prefer KALSHI_DEMO_PRIVATE_KEY (PEM contents) over a file path.
KALSHI_DEMO_API_KEY_ID=
KALSHI_DEMO_PRIVATE_KEY=
# Optional: PEM file path if you do not want the key contents in the env var.
KALSHI_DEMO_PRIVATE_KEY_PATH=
KALSHI_LIVE_TRADING=false
